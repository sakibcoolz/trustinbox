scalar Time
scalar DateTime
scalar JSON

# ============================================================
# ENUMS
# ============================================================

enum NotificationCategory {
  PERSONAL
  SERVICE_PROVIDER
  ADVERTISEMENT
}

enum CallbackRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RESCHEDULED
  EXPIRED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

# ============================================================
# TYPES
# ============================================================

type User {
  id: ID!
  username: String!
  fullName: String!
  email: String
  virtualPublicId: String!
  avatarUrl: String
  timezone: String!
  language: String!
  privacyPreference: PrivacyPreference
  availabilitySlots: [AvailabilitySlot!]!
  dndRules: [DNDRule!]!
}

type PrivacyPreference {
  allowPersonalNotifications: Boolean!
  allowSPNotifications: Boolean!
  allowAdvertisements: Boolean!
  allowCallbackRequests: Boolean!
  allowChat: Boolean!
  allowDocumentShares: Boolean!
  requireCallApproval: Boolean!
  notificationSoundEnabled: Boolean!
}

type DNDRule {
  id: ID!
  scopeType: String!
  scopeRefId: ID
  startTime: String!
  endTime: String!
  daysOfWeek: [Int!]!
  isActive: Boolean!
}

type AvailabilitySlot {
  id: ID!
  dayOfWeek: Int!
  startTime: String!
  endTime: String!
  slotType: String!
  isActive: Boolean!
}

type ServiceProvider {
  id: ID!
  slug: String!
  name: String!
  legalName: String
  industry: String!
  description: String
  verificationStatus: String!
  status: String!
  website: String
  address: String
  city: String
  state: String
  country: String
  postalCode: String
  latitude: Float
  longitude: Float
}

type UserAddress {
  id: ID!
  userId: ID!
  label: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  state: String
  postalCode: String
  country: String!
  latitude: Float
  longitude: Float
  isCurrent: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type Notification {
  id: ID!
  category: NotificationCategory!
  title: String!
  body: String!
  priority: String!
  status: String!
  metadata: JSON
  serviceProvider: ServiceProvider
  createdAt: DateTime!
}

type NotificationConnection {
  nodes: [Notification!]!
  totalCount: Int!
}

type CallbackRequest {
  id: ID!
  serviceProvider: ServiceProvider!
  reason: String!
  details: String
  status: CallbackRequestStatus!
  requestedAt: DateTime!
  respondedAt: DateTime
  approvedSlotStart: DateTime
  approvedSlotEnd: DateTime
}

type CallbackRequestConnection {
  nodes: [CallbackRequest!]!
  totalCount: Int!
}

type Conversation {
  id: ID!
  status: ConversationStatus!
  serviceProvider: ServiceProvider!
  messages(limit: Int, offset: Int): MessageConnection!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type ConversationConnection {
  nodes: [Conversation!]!
  totalCount: Int!
}

type Message {
  id: ID!
  senderType: String!
  senderRefId: ID
  messageType: String!
  content: String!
  metadata: JSON
  createdAt: DateTime!
}

type MessageConnection {
  nodes: [Message!]!
  totalCount: Int!
}

type DocumentShare {
  id: ID!
  documentId: ID!
  fileName: String!
  fileType: String!
  shareContext: String!
  serviceProvider: ServiceProvider!
  createdAt: DateTime!
  openedAt: DateTime
}

type DashboardSummary {
  unreadPersonal: Int!
  unreadServiceProvider: Int!
  unreadAdvertisements: Int!
  pendingCallbackRequests: Int!
  totalConversations: Int!
}

type PolicyCheckResult {
  allowed: Boolean!
  decisionCode: String!
  reason: String!
  appliedRules: [String!]!
}

# ─── Customer Portal Types ─────────────────────────────

type UserProfile {
  id: ID!
  username: String!
  fullName: String!
  email: String
  avatarUrl: String
  timezone: String!
  language: String!
}

type CustomerDashboardSummary {
  unreadNotifications: Int!
  pendingCallbacks: Int!
  activeConversations: Int!
  sharedDocuments: Int!
  blockedProviders: Int!
  dndActive: Boolean!
}

type BlockedProviderConnection {
  nodes: [BlockedProvider!]!
  totalCount: Int!
}

type BlockedProvider {
  serviceProvider: ServiceProvider!
  blockedAt: Time!
  reason: String
}

type DocumentConnection {
  nodes: [DocumentShare!]!
  totalCount: Int!
}

type ServiceProviderConnection {
  nodes: [ServiceProvider!]!
  totalCount: Int!
}

# ============================================================
# INPUTS
# ============================================================

input UpdateProfileInput {
  firstName: String
  lastName: String
  avatarUrl: String
  timezone: String
  language: String
}

input UpdatePrivacyPreferenceInput {
  allowPersonalNotifications: Boolean
  allowSPNotifications: Boolean
  allowAdvertisements: Boolean
  allowCallbackRequests: Boolean
  allowChat: Boolean
  allowDocumentShares: Boolean
  requireCallApproval: Boolean
  notificationSoundEnabled: Boolean
}

input CreateDNDRuleInput {
  scopeType: String!
  scopeRefId: ID
  startTime: String!
  endTime: String!
  daysOfWeek: [Int!]!
  isActive: Boolean!
}

input UpdateDNDRuleInput {
  id: ID!
  startTime: String
  endTime: String
  daysOfWeek: [Int!]
  isActive: Boolean
}

input CreateAvailabilitySlotInput {
  dayOfWeek: Int!
  startTime: String!
  endTime: String!
  slotType: String!
}

input ApproveCallbackRequestInput {
  callbackRequestId: ID!
  approvedSlotStart: DateTime!
  approvedSlotEnd: DateTime!
}

input RejectCallbackRequestInput {
  callbackRequestId: ID!
  reason: String
}

input SendMessageInput {
  conversationId: ID!
  content: String!
  messageType: String
}

input SendNotificationInput {
  userId: ID!
  category: NotificationCategory!
  title: String!
  body: String!
  priority: NotificationPriority
  metadata: JSON
}

input CreateCallbackRequestInput {
  userId: ID!
  reason: String!
  details: String
}

input ReportSpamInput {
  serviceProviderId: ID!
  notificationId: ID
  callbackRequestId: ID
  reason: String!
  details: String
}



enum WebhookSubscriptionStatus {
  ACTIVE_SUBSCRIPTION
  PAUSED_SUBSCRIPTION
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING_DELIVERY
  DELIVERING
  DELIVERED
  FAILED_DELIVERY
  EXPIRED
}

enum CampaignStatus {
  DRAFT_CAMPAIGN
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

# ============================================================
# INDUSTRY PROFILE TYPES
# ============================================================

type IndustryProfile {
  id: ID!
  industryKey: String!
  displayName: String!
  description: String
  defaultCategories: [String!]!
  complianceHintsJson: String
  documentTypesJson: String
  callbackWorkflowsJson: String
  dashboardPresetsJson: String
  analyticsPresetsJson: String
  isActive: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type IndustryProfileConnection {
  nodes: [IndustryProfile!]!
  totalCount: Int!
}

# ============================================================
# WEBHOOK TYPES
# ============================================================

type WebhookSubscription {
  id: ID!
  serviceProviderId: ID!
  url: String!
  description: String
  events: [String!]!
  status: WebhookSubscriptionStatus!
  failureCount: Int!
  maxRetries: Int!
  lastDeliveryAt: DateTime
  lastFailureAt: DateTime
  createdAt: DateTime!
  updatedAt: DateTime!
}

type WebhookSubscriptionConnection {
  nodes: [WebhookSubscription!]!
  totalCount: Int!
}

type WebhookDelivery {
  id: ID!
  subscriptionId: ID!
  eventType: String!
  eventId: String!
  responseStatus: Int
  attemptCount: Int!
  status: WebhookDeliveryStatus!
  durationMs: Int
  createdAt: DateTime!
  completedAt: DateTime
}

type WebhookDeliveryConnection {
  nodes: [WebhookDelivery!]!
  totalCount: Int!
}

type TestWebhookResult {
  success: Boolean!
  responseStatus: Int
  responseBody: String
  durationMs: Int
}

# ============================================================
# API KEY TYPES
# ============================================================

type APIKey {
  id: ID!
  serviceProviderId: ID!
  name: String!
  prefix: String!
  scopes: [String!]!
  expiresAt: DateTime
  lastUsedAt: DateTime
  createdAt: DateTime!
}

type APIKeyWithSecret {
  apiKey: APIKey!
  secret: String!
}

type APIKeyConnection {
  nodes: [APIKey!]!
  totalCount: Int!
}

# ============================================================
# CAMPAIGN TYPES
# ============================================================

type Campaign {
  id: ID!
  serviceProviderId: ID!
  name: String!
  description: String
  category: NotificationCategory!
  status: CampaignStatus!
  targetCount: Int!
  sentCount: Int!
  deliveredCount: Int!
  readCount: Int!
  failedCount: Int!
  scheduledAt: DateTime
  startedAt: DateTime
  completedAt: DateTime
  createdAt: DateTime!
  updatedAt: DateTime!
}

type CampaignConnection {
  nodes: [Campaign!]!
  totalCount: Int!
}

type CampaignPolicyPreview {
  totalTargets: Int!
  allowedCount: Int!
  blockedCount: Int!
  blockedReasons: [PolicyBlockReason!]!
}

type PolicyBlockReason {
  decisionCode: String!
  reason: String!
  count: Int!
}

# ============================================================
# ANALYTICS TYPES
# ============================================================

type DashboardAnalytics {
  notificationsSent: Int!
  notificationsDelivered: Int!
  notificationsRead: Int!
  notificationsRejected: Int!
  callbacksRequested: Int!
  callbacksApproved: Int!
  callbacksRejected: Int!
  messagesSent: Int!
  messagesReceived: Int!
  documentsShared: Int!
  campaignsLaunched: Int!
  spamReports: Int!
  policyDenials: Int!
  webhookDeliveries: Int!
  webhookFailures: Int!
  activeConversations: Int!
  deliveryRate: Float!
  readRate: Float!
}

type DailyAnalyticsEntry {
  date: String!
  notificationsSent: Int!
  notificationsDelivered: Int!
  notificationsRead: Int!
  callbacksRequested: Int!
  callbacksApproved: Int!
  messagesSent: Int!
  documentsShared: Int!
  spamReports: Int!
  policyDenials: Int!
}

type NotificationAnalytics {
  totalSent: Int!
  totalDelivered: Int!
  totalRead: Int!
  totalRejected: Int!
  deliveryRate: Float!
  readRate: Float!
}

type CallbackAnalytics {
  totalRequested: Int!
  totalApproved: Int!
  totalRejected: Int!
  totalExpired: Int!
  approvalRate: Float!
  avgResponseTimeHours: Float!
}

type CampaignAnalytics {
  totalTargets: Int!
  totalSent: Int!
  totalDelivered: Int!
  totalRead: Int!
  totalFailed: Int!
  totalSkipped: Int!
  deliveryRate: Float!
  readRate: Float!
}


# ============================================================
# WEBHOOK INPUTS
# ============================================================

input CreateWebhookSubscriptionInput {
  serviceProviderId: ID!
  url: String!
  description: String
  events: [String!]!
  secret: String
}

input UpdateWebhookSubscriptionInput {
  subscriptionId: ID!
  serviceProviderId: ID!
  url: String
  description: String
  events: [String!]
  status: WebhookSubscriptionStatus
  newSecret: String
}

# ============================================================
# API KEY INPUTS
# ============================================================

input CreateAPIKeyInput {
  serviceProviderId: ID!
  name: String!
  scopes: [String!]!
  expiresInDays: Int
}

input RevokeAPIKeyInput {
  apiKeyId: ID!
  serviceProviderId: ID!
}

# ============================================================
# CAMPAIGN INPUTS
# ============================================================

input CreateCampaignInput {
  serviceProviderId: ID!
  name: String!
  description: String
  category: NotificationCategory!
  scheduledAt: DateTime
}

input UpdateCampaignInput {
  campaignId: ID!
  serviceProviderId: ID!
  name: String
  description: String
  scheduledAt: DateTime
}

input PreviewCampaignPolicyInput {
  serviceProviderId: ID!
  category: NotificationCategory!
  targetUserIds: [ID!]!
}

# ============================================================
# TEAM MANAGEMENT TYPES
# ============================================================

type TeamMember {
  id: ID!
  userId: ID!
  serviceProviderId: ID!
  username: String!
  email: String!
  fullName: String!
  role: TeamRole!
  status: String!
  createdAt: DateTime!
}

enum TeamRole {
  SP_ADMIN
  AGENT
  ANALYST
}

type TeamMemberConnection {
  items: [TeamMember!]!
  total: Int!
}

type TeamInvitation {
  id: ID!
  email: String!
  serviceProviderId: ID!
  role: TeamRole!
  status: InvitationStatus!
  invitedBy: ID!
  expiresAt: DateTime!
  createdAt: DateTime!
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

type InvitationConnection {
  items: [TeamInvitation!]!
  total: Int!
}

type InviteTeamMemberResult {
  invitationId: ID!
}

input InviteTeamMemberInput {
  serviceProviderId: ID!
  email: String!
  role: TeamRole!
}

input ChangeTeamMemberRoleInput {
  serviceProviderId: ID!
  targetUserId: ID!
  newRole: TeamRole!
}

input RemoveTeamMemberInput {
  serviceProviderId: ID!
  targetUserId: ID!
}

input CreateAddressInput {
  label: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  state: String
  postalCode: String
  country: String!
  latitude: Float
  longitude: Float
  isCurrent: Boolean
}

input UpdateAddressInput {
  id: ID!
  label: String
  addressLine1: String
  addressLine2: String
  city: String
  state: String
  postalCode: String
  country: String
  latitude: Float
  longitude: Float
  isCurrent: Boolean
}

# ============================================================
# QUERIES
# ============================================================

type Query {
  # User
  me: User!
  dashboardSummary: DashboardSummary!

  # Notifications
  notifications(
    category: NotificationCategory
    status: String
    limit: Int
    offset: Int
  ): NotificationConnection!

  notification(id: ID!): Notification!

  # Callback Requests
  callbackRequests(
    status: CallbackRequestStatus
    limit: Int
    offset: Int
  ): CallbackRequestConnection!

  callbackRequest(id: ID!): CallbackRequest!

  # Conversations
  conversations(
    limit: Int
    offset: Int
  ): ConversationConnection!

  conversation(id: ID!): Conversation!

  # Service Providers
  serviceProviders(
    search: String
    limit: Int
    offset: Int
  ): [ServiceProvider!]!

  serviceProvider(id: ID!): ServiceProvider!

  # Policy
  checkCommunicationPolicy(
    serviceProviderId: ID!
    category: NotificationCategory!
    channel: String!
  ): PolicyCheckResult!


  # Industry Profiles
  industryProfile(industryKey: String!): IndustryProfile!
  industryProfiles(
    activeOnly: Boolean
    limit: Int
    offset: Int
  ): IndustryProfileConnection!

  # Webhook Subscriptions
  webhookSubscription(id: ID!, serviceProviderId: ID!): WebhookSubscription!
  webhookSubscriptions(
    serviceProviderId: ID!
    status: WebhookSubscriptionStatus
    limit: Int
    offset: Int
  ): WebhookSubscriptionConnection!
  webhookDeliveries(
    subscriptionId: ID!
    serviceProviderId: ID!
    status: WebhookDeliveryStatus
    limit: Int
    offset: Int
  ): WebhookDeliveryConnection!

  # API Keys
  apiKeys(serviceProviderId: ID!): APIKeyConnection!

  # Campaigns
  campaign(id: ID!, serviceProviderId: ID!): Campaign!
  campaigns(
    serviceProviderId: ID!
    status: CampaignStatus
    limit: Int
    offset: Int
  ): CampaignConnection!
  previewCampaignPolicy(input: PreviewCampaignPolicyInput!): CampaignPolicyPreview!

  # Analytics
  dashboardAnalytics(
    serviceProviderId: ID!
    from: DateTime!
    to: DateTime!
  ): DashboardAnalytics!
  dailyAnalytics(
    serviceProviderId: ID!
    from: DateTime!
    to: DateTime!
  ): [DailyAnalyticsEntry!]!
  notificationAnalytics(
    serviceProviderId: ID!
    from: DateTime!
    to: DateTime!
  ): NotificationAnalytics!
  callbackAnalytics(
    serviceProviderId: ID!
    from: DateTime!
    to: DateTime!
  ): CallbackAnalytics!
  campaignAnalytics(
    serviceProviderId: ID!
    campaignId: ID!
    from: DateTime
    to: DateTime
  ): CampaignAnalytics!

  # Team Management
  teamMembers(
    serviceProviderId: ID!
    limit: Int
    offset: Int
  ): TeamMemberConnection!

  pendingInvitations(
    serviceProviderId: ID!
    limit: Int
    offset: Int
  ): InvitationConnection!

  myServiceProviders(
    limit: Int
    offset: Int
    search: String
  ): ServiceProviderConnection!

  # ─── Customer Portal Queries ────────────────────────────

  myProfile: UserProfile!

  myNotifications(
    limit: Int
    offset: Int
    category: NotificationCategory
    status: String
  ): NotificationConnection!

  myCallbackRequests(
    limit: Int
    offset: Int
    status: CallbackRequestStatus
  ): CallbackRequestConnection!

  myConversations(
    limit: Int
    offset: Int
    status: ConversationStatus
  ): ConversationConnection!

  myDocuments(
    limit: Int
    offset: Int
    serviceProviderId: ID
    classification: String
  ): DocumentConnection!

  myPrivacyPreferences: PrivacyPreference!

  myDNDRules: [DNDRule!]!

  myAvailabilitySlots: [AvailabilitySlot!]!

  myBlockedProviders(
    limit: Int
    offset: Int
  ): BlockedProviderConnection!

  myDashboardSummary: CustomerDashboardSummary!

  serviceProviderDirectory(
    limit: Int
    offset: Int
    search: String
    industry: String
  ): ServiceProviderConnection!

  followedServiceProviders(
    limit: Int
    offset: Int
    search: String
  ): ServiceProviderConnection!

  nearbyServiceProviders(
    latitude: Float!
    longitude: Float!
    radiusKm: Float
    limit: Int
    offset: Int
  ): ServiceProviderConnection!

  # User Addresses
  myAddresses: [UserAddress!]!
  myCurrentAddress: UserAddress
}

# ============================================================
# MUTATIONS
# ============================================================

type Mutation {
  # Privacy & Settings
  updatePrivacyPreference(input: UpdatePrivacyPreferenceInput!): PrivacyPreference!
  createDNDRule(input: CreateDNDRuleInput!): DNDRule!
  updateDNDRule(input: UpdateDNDRuleInput!): DNDRule!
  deleteDNDRule(id: ID!): Boolean!
  createAvailabilitySlot(input: CreateAvailabilitySlotInput!): AvailabilitySlot!
  deleteAvailabilitySlot(id: ID!): Boolean!

  # Callback Requests
  approveCallbackRequest(input: ApproveCallbackRequestInput!): CallbackRequest!
  rejectCallbackRequest(input: RejectCallbackRequestInput!): CallbackRequest!

  # Messages
  sendMessage(input: SendMessageInput!): Message!

  # Service Provider actions
  blockServiceProvider(serviceProviderId: ID!, reason: String): Boolean!
  unblockServiceProvider(serviceProviderId: ID!): Boolean!
  reportSpam(input: ReportSpamInput!): Boolean!

  # Notifications (read)
  markNotificationAsRead(id: ID!): Boolean!
  archiveNotification(id: ID!): Boolean!

  # ─── Customer Portal Mutations ──────────────────────────

  updateMyProfile(input: UpdateProfileInput!): UserProfile!
  updateMyAvatar(url: String!): UserProfile!
  markAllNotificationsRead: Boolean!

  # Service Provider portal mutations
  sendNotification(input: SendNotificationInput!): Notification!
  createCallbackRequest(input: CreateCallbackRequestInput!): CallbackRequest!


  # Webhook Subscriptions
  createWebhookSubscription(input: CreateWebhookSubscriptionInput!): WebhookSubscription!
  updateWebhookSubscription(input: UpdateWebhookSubscriptionInput!): WebhookSubscription!
  deleteWebhookSubscription(subscriptionId: ID!, serviceProviderId: ID!): Boolean!
  testWebhookSubscription(subscriptionId: ID!, serviceProviderId: ID!): TestWebhookResult!
  retryWebhookDelivery(deliveryId: ID!, serviceProviderId: ID!): Boolean!

  # API Keys
  createAPIKey(input: CreateAPIKeyInput!): APIKeyWithSecret!
  revokeAPIKey(input: RevokeAPIKeyInput!): Boolean!

  # Campaigns
  createCampaign(input: CreateCampaignInput!): Campaign!
  updateCampaign(input: UpdateCampaignInput!): Campaign!
  cancelCampaign(campaignId: ID!, serviceProviderId: ID!): Boolean!
  launchCampaign(campaignId: ID!, serviceProviderId: ID!): Campaign!

  # Team Management
  inviteTeamMember(input: InviteTeamMemberInput!): InviteTeamMemberResult!
  acceptInvitation(token: String!): Boolean!
  revokeInvitation(invitationId: ID!, serviceProviderId: ID!): Boolean!
  changeTeamMemberRole(input: ChangeTeamMemberRoleInput!): Boolean!
  removeTeamMember(input: RemoveTeamMemberInput!): Boolean!

  # User Addresses
  createAddress(input: CreateAddressInput!): UserAddress!
  updateAddress(input: UpdateAddressInput!): UserAddress!
  deleteAddress(id: ID!): Boolean!
  setCurrentAddress(id: ID!): Boolean!
}

# ============================================================
# SUBSCRIPTIONS
# ============================================================

type Subscription {
  # User subscriptions
  notificationReceived: Notification!
  callbackRequestUpdated(id: ID!): CallbackRequest!
  messageReceived(conversationId: ID!): Message!

  # Provider-specific real-time subscriptions
  providerNotificationDelivered(serviceProviderId: ID!): Notification!
  providerCallbackRequestCreated(serviceProviderId: ID!): CallbackRequest!
  providerMessageReceived(serviceProviderId: ID!): Message!
  providerWebhookDeliveryCompleted(serviceProviderId: ID!): WebhookDelivery!
  providerCampaignProgressUpdated(serviceProviderId: ID!): Campaign!
}
