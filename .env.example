# ─── Environment ────────────────────────────────────────
SERVICE_NAME=trustinbox
ENVIRONMENT=development

# ─── PostgreSQL ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=trustinbox
DB_PASSWORD=trustinbox_dev
DB_NAME=trustinbox
DB_SSL_MODE=disable

# ─── Redis ──────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── MinIO / S3 ────────────────────────────────────────
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=trustinbox
S3_SECRET_KEY=trustinbox_dev
S3_BUCKET=trustinbox-docs
S3_USE_SSL=false

# ─── OpenTelemetry ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── gRPC Ports ─────────────────────────────────────────
AUTH_SERVICE_ADDR=localhost:50051
USER_SERVICE_ADDR=localhost:50052
POLICY_SERVICE_ADDR=localhost:50053
ORG_SERVICE_ADDR=localhost:50054
NOTIFICATION_SERVICE_ADDR=localhost:50055
COMMUNICATION_SERVICE_ADDR=localhost:50056
AI_SERVICE_ADDR=localhost:50057
WORKER_SERVICE_ADDR=localhost:50058

# ─── Gateway ───────────────────────────────────────────
GATEWAY_HTTP_PORT=4000
# Public URL n8n uses to call back into the gateway for async workflow resumes.
GATEWAY_PUBLIC_URL=http://host.docker.internal:4000

# ─── n8n Workflow Integration ──────────────────────────
# Base URL of the n8n instance. From the host use http://localhost:5678,
# from inside Docker use http://n8n:5678.
N8N_BASE_URL=http://localhost:5678
# Shared HMAC-SHA256 secret. MUST match TRUSTINBOX_WEBHOOK_SECRET in docker-compose.infra.yml.
N8N_WEBHOOK_SECRET=trustinbox_n8n_webhook_secret_dev

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
